# 复制为 /etc/workbench/env，属主 workbench:workbench，模式 0400。真值永不进仓库。
WB_PORT=3000
WB_HOST=127.0.0.1
# 网页登录口令已改存 wb.db（scrypt 哈希），此处不再配口令。
# 改密：在网页页眉点“改密”或调 POST /api/auth/password（登录态）。
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=__FILL_ME__
# 告警外送 webhook（ntfy 或自建，空=关闭）。示例 ntfy：https://ntfy.sh/<topic>
ALERT_WEBHOOK_URL=
