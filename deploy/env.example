# AntifieldComplexx v0.8.1 生产环境变量示例（真实文件由 scripts/bootstrap-env.sh 生成）
# 真实文件：/etc/antifieldcloud/env，权限 0640 root:antifieldcloud
# 非敏感值也可写入 /etc/antifieldcloud/deploy.conf，bootstrap --force 不会重置为示例值。

NODE_ENV=production
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

DATA_DIR=/var/lib/antifieldcloud
WEB_DIST_DIR=/opt/antifieldcloud/current/apps/workbench/web/dist

APP_ORIGIN=https://app.example.com
AI_ORIGIN=https://ai.example.com
# v0.6.0 起仅用于清理旧父域 Cookie（不设置新 Cookie）；新装可留空，生产建议保留以精确清理
COOKIE_DOMAIN=.example.com
ALLOW_INSECURE_LOOPBACK=true

QUOTA_BYTES=10737418240
# Cloudflare 代理请求体上限：Free/Pro 100 MB、Business 200 MB；默认按 100 MiB 配置。
MAX_UPLOAD_BYTES=104857600
MAX_FILES_PER_REQUEST=20
TEXT_PREVIEW_BYTES=1048576
TRASH_RETENTION_DAYS=30
SESSION_TTL_DAYS=7
CHALLENGE_TTL_SECONDS=300
AUDIT_RETENTION_DAYS=90

ADMIN_USERNAME=antifield

MC_HOST=127.0.0.1
MC_PORT=25565
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=__FROM_SERVER_PROPERTIES__
MC_PUBLIC_ADDRESS=mc.example.com:11798
MC_SYSTEMD_UNIT=minecraft
# 仅 bootstrap-env.sh 读取/写入（服务端不读取）：安装位置覆盖项。
MC_PROPERTIES=/home/antifield/minecraft-server/server.properties
OPENCODE_ENV=/etc/opencode/opencode.env

OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=__FROM_OPENCODE_ENV__

# v0.2.0：文件分享（公开链接默认 7 天过期，最长 30 天）。
SHARES_ENABLED=true
SHARE_DEFAULT_EXPIRY_HOURS=168
SHARE_MAX_EXPIRY_HOURS=720
SHARE_MAX_DOWNLOADS=10000

# v0.2.0：主机告警（探针 JSON 由 antifieldcloud-health.timer 写入）。
ALERTS_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=generic
ALERT_WEBHOOK_SECRET=
ALERT_DISK_FREE_PCT=15
ALERT_TEMP_C=80
ALERT_BACKUP_MAX_AGE_HOURS=48
ALERT_COOLDOWN_MINUTES=360
# 持续 firing 的重通知间隔（小时，v0.7.2）；0=关闭。新键优先于旧 ALERT_COOLDOWN_MINUTES。
ALERT_REPEAT_HOURS=24
ALERT_CHECK_INTERVAL_SECONDS=300
PI_HEALTH_FILE=/run/antifieldcloud/pi-health.json

BACKUP_PULL_FILE=/var/lib/antifieldcloud/backup-pull.json
BACKUP_RESTORE_ENABLED=false
BACKUP_IMPORT_MAX_BYTES=104857600
# Web 导入归档保留天数；0=永久保留（v0.7.2 默认 90）。
BACKUP_IMPORT_RETENTION_DAYS=90
BACKUP_RESTORE_PLAN_TTL_MINUTES=30
BACKUP_RESTORE_MAX_ENTRIES=5000
# Web 触发 prepare 的超时（秒），与 CLI/PC 侧 55 分钟对齐，避免大归档中途被杀。
BACKUP_PREPARE_TIMEOUT_SEC=3300

# v0.7.0 备份整包加密 + 异地副本（默认关闭）。
# 启用顺序：离线生成 age 密钥对 → Pi 只放公钥 → 私钥完成一次解密/演练 → 打开开关 → 下一次 prepare 生成 .age。
# 加密开启时 age 缺失/公钥非法/加密失败会让 prepare 失败（失败关闭，不降级明文）。
BACKUP_ARCHIVE_ENCRYPTION=false
# backup age 公钥文件（root 所有、组/其他不可写）；与 secrets-age 密钥对相互独立。
BACKUP_AGE_RECIPIENT_FILE=/etc/antifieldcloud/backup-age.pub
# 异地副本状态（PC 端 backup-offsite.ps1 写入，应用只读；缺失视为未启用，不告警）。
BACKUP_OFFSITE_STATUS_FILE=/var/lib/antifieldcloud/backup-offsite-status.json

# v0.4.0 备份/灾备状态文件（root 世界备份脚本与 PC 拉取/演练脚本写入，应用只读）。
WORLD_BACKUP_STATUS_FILE=/var/lib/antifieldcloud/world-backup-status.json
WORLD_PULL_STATUS_FILE=/var/lib/antifieldcloud/world-pull-status.json
DRILL_STATUS_FILE=/var/lib/antifieldcloud/drill-status.json
ALERT_WORLD_BACKUP_MAX_AGE_HOURS=192
ALERT_DRILL_MAX_AGE_DAYS=35
# 异地副本超期告警：状态缺失/未启用时不误报（48h）。
ALERT_OFFSITE_MAX_AGE_HOURS=48

# v0.4.0 笔记附件与版本历史。
NOTE_ATTACHMENT_MAX_BYTES=26214400
NOTE_MAX_ATTACHMENTS=100
NOTE_VERSIONS_KEEP=20
# v0.4.0 多文件打包分享上限（逐文件下载，不生成 zip）。
SHARE_MAX_ITEMS=50

# v0.4.0 指标历史：默认 60 秒采样、保留 30 天。
METRICS_ENABLED=true
METRICS_SAMPLE_SECONDS=60
METRICS_RETENTION_DAYS=30

# v0.5.0 Bot：BOT_SECRET_KEY 由 bootstrap-env.sh 生成（32 字节 base64，用于 AES-256-GCM 加密平台 Token）；
# 必须与 DB 一起备份，丢失后已存 Token 不可解密，只能重新录入。
BOT_ENABLED=false
BOT_SECRET_KEY=__GENERATED_BY_BOOTSTRAP__
BOT_WEBHOOK_MAX_BODY_BYTES=262144
BOT_DELIVERY_INTERVAL_SECONDS=30
BOT_DELIVERY_MAX_ATTEMPTS=5
BOT_EVENT_RETENTION_DAYS=7
BOT_COMMAND_RATE_PER_MINUTE=120
BOT_PUBLISH_MAX_SCHEDULED_DAYS=30
BOT_MAX_BOTS=10

# v0.5.1 Bot AI（OpenCode 本地 API，供普通消息 Chat 使用；默认关闭，按用户限流；
# 以下 7 项已由 bootstrap-env.sh 纳管，--force 不会重置已有非空值）。
BOT_AI_ENABLED=false
BOT_AI_PROVIDER=
BOT_AI_MODEL=
BOT_AI_TIMEOUT_SECONDS=60
BOT_AI_MAX_PROMPT_CHARS=2000
BOT_AI_RATE_PER_HOUR=120
BOT_AI_SESSION_RETENTION_DAYS=7

# v0.5.2 Chat/长期记忆（默认安全关闭；启用前先在目标上开 allow_chat）。
BOT_CHAT_RATE_PER_MINUTE=30
BOT_AI_MEMORY_MAX_CHARS=4096
BOT_AI_MEMORY_RETENTION_DAYS=365
BOT_AI_MEMORY_BATCH_MESSAGES=3
BOT_AI_MEMORY_IDLE_FLUSH_SECONDS=120
BOT_MEMORY_MAX_ITEMS=200
BOT_MEMORY_PROMPT_MAX_CHARS=3000
BOT_MEMORY_PROMPT_MAX_ITEMS=12
BOT_MEMORY_TTL_EPISODE_DAYS=90
BOT_MEMORY_TTL_TASK_DAYS=30

# v0.5.7/v0.5.8：AI 回答长度上限与图片理解（QQ 入站图片 → OpenCode 视觉；默认开启）。
BOT_AI_MAX_REPLY_CHARS=4000
BOT_AI_VISION_ENABLED=true
BOT_AI_IMAGE_MAX_BYTES=10485760

# v0.5.3 Bot 出站连通性探测与自动恢复（Pi 直连 QQ 平台；不再依赖 PC 代理隧道）。
BOT_CONNECTIVITY_ENABLED=true
BOT_CONNECTIVITY_INTERVAL_SECONDS=60
BOT_CONNECTIVITY_TIMEOUT_SECONDS=8

# v0.6.1 Bot 连续消息合并 + SearXNG 联网搜索（默认关闭搜索；启用前先部署私有 SearXNG）。
# 同一 Bot×目标×用户的 burst 合并窗口（0 关闭合并但仍串行）、最长等待、单批上限。
BOT_CHAT_BURST_WINDOW_MS=3000
BOT_CHAT_BURST_MAX_WAIT_MS=10000
BOT_CHAT_BURST_MAX_MESSAGES=10

# v0.6.4 全量群聊的非 @ 消息使用更长合并窗口，减少逐条调用模型；@/名字命中仍走上面的即时窗口。
BOT_CHAT_BURST_GROUP_ALL_WINDOW_MS=8000
BOT_CHAT_BURST_GROUP_ALL_MAX_WAIT_MS=20000
# 模型消息发送工具：需先运行 scripts/install-bot-tool-mcp.sh 安装 botmsg MCP，再开启。
BOT_AI_SEND_TOOL_ENABLED=false
# v0.7.3 上下文文档 + read 工具：角色卡/记忆落盘为只读文档，模型按需 read；默认关闭。
# 开启前必须完成 OpenCode 读范围验证，并创建 OpenCode 组可读的独立目录（见 docs/DEPLOY.md）。
BOT_AI_CONTEXT_READ_ENABLED=false
BOT_CONTEXT_DIR=/var/lib/antifieldcloud-context
# SearXNG 仅监听 loopback；BOT_SEARCH_ENABLED=true 时必须配置 URL。
BOT_SEARCH_ENABLED=false
BOT_SEARCH_URL=http://127.0.0.1:8888
BOT_SEARCH_AUTO=true
# mcp=模型通过 SearXNG MCP 工具自行决定；prefetch=服务端关键词预取（兼容/回退）
BOT_SEARCH_MODE=mcp
BOT_SEARCH_MAX_RESULTS=5
BOT_SEARCH_TIMEOUT_SECONDS=8
BOT_SEARCH_MAX_SNIPPET_CHARS=500
BOT_SEARCH_LANGUAGE=zh-CN
BOT_SEARCH_SAFESEARCH=true
BOT_SEARCH_ENGINES=bing
BOT_SEARCH_RATE_PER_HOUR=60

# v0.8.0 Lofii Minecraft Bot 对接（默认关闭；lofii-bot v0.6.0+ 仅监听 loopback）。
# READ/CONTROL Token 由 root 执行 scripts/sync-lofii-tokens.sh 从 /etc/lofii-bot/env 同步；
# 不要把 lofii 的 RCON/OpenCode 密码复制到本文件。
LOFII_ENABLED=false
LOFII_URL=http://127.0.0.1:3010
LOFII_READ_TOKEN=
LOFII_CONTROL_TOKEN=
LOFII_TIMEOUT_MS=2500
LOFII_POLL_MS=5000
LOFII_ALERTS_ENABLED=true

# v0.3.0 OpenCode HTML 模式：shim 兜底；Cloudflare 关闭 Rocket Loader 后可为 attributes/passthrough。
OPENCODE_HTML_MODE=shim

# v0.3.1 大文件分片：单文件上限 5 GiB，8 MiB 块，24h 会话。
CHUNKED_UPLOAD_ENABLED=true
CHUNK_SIZE_BYTES=8388608
CHUNK_MAX_FILE_BYTES=5368709120
CHUNK_SESSION_TTL_HOURS=24
CHUNK_MAX_CONCURRENT_SESSIONS=3

TZ=Asia/Shanghai
# 可覆盖版本号；生产默认由 package.json 读取（部署脚本会注入并校验）。
APP_VERSION=0.8.1
