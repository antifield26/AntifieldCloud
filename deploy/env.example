# AntifieldCloud 生产环境变量示例（由 scripts/bootstrap-env.sh 生成真实文件）
# 真实文件：/etc/antifieldcloud/env，权限 0640 root:antifieldcloud

NODE_ENV=production
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

DATA_DIR=/var/lib/antifieldcloud
WEB_DIST_DIR=/opt/antifieldcloud/current/web/dist

APP_ORIGIN=https://app.example.com
AI_ORIGIN=https://ai.example.com
COOKIE_DOMAIN=.example.com
ALLOW_INSECURE_LOOPBACK=true

QUOTA_BYTES=10737418240
MAX_UPLOAD_BYTES=2147483648
MAX_FILES_PER_REQUEST=20
TEXT_PREVIEW_BYTES=1048576
TRASH_RETENTION_DAYS=30
SESSION_TTL_DAYS=7
CHALLENGE_TTL_SECONDS=300
AUDIT_RETENTION_DAYS=90

ADMIN_USERNAME=antifield

MC_HOST=127.0.0.1
MC_PORT=25565
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=__FROM_SERVER_PROPERTIES__
MC_PUBLIC_ADDRESS=mc.example.com:11798
MC_SYSTEMD_UNIT=minecraft

OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=__FROM_OPENCODE_ENV__

BACKUP_PULL_FILE=/var/lib/antifieldcloud/backup-pull.json
TZ=Asia/Shanghai
APP_VERSION=0.1.0
