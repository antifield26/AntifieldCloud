# AntifieldCloud v0.5.0 生产环境变量示例（真实文件由 scripts/bootstrap-env.sh 生成）
# 真实文件：/etc/antifieldcloud/env，权限 0640 root:antifieldcloud
# 非敏感值也可写入 /etc/antifieldcloud/deploy.conf，bootstrap --force 不会重置为示例值。

NODE_ENV=production
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

DATA_DIR=/var/lib/antifieldcloud
WEB_DIST_DIR=/opt/antifieldcloud/current/web/dist

APP_ORIGIN=https://app.example.com
AI_ORIGIN=https://ai.example.com
COOKIE_DOMAIN=.example.com
ALLOW_INSECURE_LOOPBACK=true

QUOTA_BYTES=10737418240
# Cloudflare 代理请求体上限：Free/Pro 100 MB、Business 200 MB；默认按 100 MiB 配置。
MAX_UPLOAD_BYTES=104857600
MAX_FILES_PER_REQUEST=20
TEXT_PREVIEW_BYTES=1048576
TRASH_RETENTION_DAYS=30
SESSION_TTL_DAYS=7
CHALLENGE_TTL_SECONDS=300
AUDIT_RETENTION_DAYS=90

ADMIN_USERNAME=antifield

MC_HOST=127.0.0.1
MC_PORT=25565
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=__FROM_SERVER_PROPERTIES__
MC_PUBLIC_ADDRESS=mc.example.com:11798
MC_SYSTEMD_UNIT=minecraft

OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=__FROM_OPENCODE_ENV__

# v0.2.0：文件分享（公开链接默认 7 天过期，最长 30 天）。
SHARES_ENABLED=true
SHARE_DEFAULT_EXPIRY_HOURS=168
SHARE_MAX_EXPIRY_HOURS=720
SHARE_MAX_DOWNLOADS=10000

# v0.2.0：主机告警（探针 JSON 由 antifieldcloud-health.timer 写入）。
ALERTS_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=generic
ALERT_WEBHOOK_SECRET=
ALERT_DISK_FREE_PCT=15
ALERT_TEMP_C=80
ALERT_BACKUP_MAX_AGE_HOURS=48
ALERT_COOLDOWN_MINUTES=360
ALERT_CHECK_INTERVAL_SECONDS=300
PI_HEALTH_FILE=/run/antifieldcloud/pi-health.json

BACKUP_PULL_FILE=/var/lib/antifieldcloud/backup-pull.json
BACKUP_RESTORE_ENABLED=true
BACKUP_IMPORT_MAX_BYTES=104857600
BACKUP_RESTORE_PLAN_TTL_MINUTES=30
BACKUP_RESTORE_MAX_ENTRIES=5000
# Web 触发 prepare 的超时（秒），与 CLI/PC 侧 55 分钟对齐，避免大归档中途被杀。
BACKUP_PREPARE_TIMEOUT_SEC=3300

# v0.4.0 备份/灾备状态文件（root 世界备份脚本与 PC 拉取/演练脚本写入，应用只读）。
WORLD_BACKUP_STATUS_FILE=/var/lib/antifieldcloud/world-backup-status.json
WORLD_PULL_STATUS_FILE=/var/lib/antifieldcloud/world-pull-status.json
DRILL_STATUS_FILE=/var/lib/antifieldcloud/drill-status.json
ALERT_WORLD_BACKUP_MAX_AGE_HOURS=192
ALERT_DRILL_MAX_AGE_DAYS=35

# v0.4.0 笔记附件与版本历史。
NOTE_ATTACHMENT_MAX_BYTES=26214400
NOTE_MAX_ATTACHMENTS=100
NOTE_VERSIONS_KEEP=20
# v0.4.0 多文件打包分享上限（逐文件下载，不生成 zip）。
SHARE_MAX_ITEMS=50

# v0.4.0 指标历史：默认 60 秒采样、保留 30 天。
METRICS_ENABLED=true
METRICS_SAMPLE_SECONDS=60
METRICS_RETENTION_DAYS=30

# v0.5.0 Bot：BOT_SECRET_KEY 由 bootstrap-env.sh 生成（32 字节 base64，用于 AES-256-GCM 加密平台 Token）；
# 必须与 DB 一起备份，丢失后已存 Token 不可解密，只能重新录入。
BOT_ENABLED=false
BOT_SECRET_KEY=__GENERATED_BY_BOOTSTRAP__
BOT_WEBHOOK_MAX_BODY_BYTES=262144
BOT_DELIVERY_INTERVAL_SECONDS=30
BOT_DELIVERY_MAX_ATTEMPTS=5
BOT_EVENT_RETENTION_DAYS=7
BOT_COMMAND_RATE_PER_MINUTE=20
BOT_PUBLISH_MAX_MEDIA_BYTES=10485760
BOT_PUBLISH_MAX_SCHEDULED_DAYS=30
BOT_MAX_BOTS=10

# v0.3.0 OpenCode HTML 模式：shim 兜底；Cloudflare 关闭 Rocket Loader 后可为 attributes/passthrough。
OPENCODE_HTML_MODE=shim

# v0.3.1 大文件分片：单文件上限 5 GiB，8 MiB 块，24h 会话。
CHUNKED_UPLOAD_ENABLED=true
CHUNK_SIZE_BYTES=8388608
CHUNK_MAX_FILE_BYTES=5368709120
CHUNK_SESSION_TTL_HOURS=24
CHUNK_MAX_CONCURRENT_SESSIONS=3

TZ=Asia/Shanghai
# 可覆盖版本号；生产默认由 package.json 读取（部署脚本会注入并校验）。
APP_VERSION=0.5.0
