[Unit]
Description=AntifieldComplexx comprehensive interaction platform
Documentation=file:///opt/antifieldcloud/current/docs/app/DEPLOY.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=antifieldcloud
Group=antifieldcloud
WorkingDirectory=/opt/antifieldcloud/current/apps/workbench
EnvironmentFile=/etc/antifieldcloud/env
Environment=NODE_ENV=production
# 主机健康探针（antifieldcloud-health.timer）写入的只读 JSON，供告警模块读取。
Environment=PI_HEALTH_FILE=/run/antifieldcloud/pi-health.json
ExecStart=/usr/local/bin/node server/src/main.ts
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/antifieldcloud
# v0.7.3：Chatbot 上下文文档目录（独立目录，需 OpenCode 组可读；启用 CHATBOT_AI_CONTEXT_READ_ENABLED 前创建）。
ReadWritePaths=/var/lib/antifieldcloud-chatbot-context
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
LimitNOFILE=65535
MemoryMax=512M

[Install]
WantedBy=multi-user.target

