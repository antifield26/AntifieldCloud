[Unit]
Description=OpenCode Server (localhost only, proxied by gateway)
After=network-online.target workbench-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=workbench
WorkingDirectory=/var/lib/workbench/opencode
EnvironmentFile=/etc/workbench/env
ExecStart=/usr/local/bin/opencode serve --port 4096 --hostname 127.0.0.1
Restart=on-failure
RestartSec=5
MemoryMax=1G
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
