{
  "name": "antifieldcomplexx",
  "version": "1.0.5",
  "private": true,
  "license": "MIT",
  "description": "AntifieldComplexx monorepo（apps/workbench + apps/mcbot）",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @antifieldcomplexx/workbench",
    "dev:web": "npm run dev:web -w @antifieldcomplexx/workbench",
    "build": "npm run build -w @antifieldcomplexx/workbench",
    "start": "npm run start -w @antifieldcomplexx/workbench",
    "typecheck": "npm run typecheck -w @antifieldcomplexx/workbench",
    "lint": "eslint apps/workbench/server apps/workbench/web scripts --max-warnings=0",
    "test": "npm run test -w @antifieldcomplexx/workbench",
    "test:coverage": "npm run test:coverage -w @antifieldcomplexx/workbench",
    "test:web": "npm run test:web -w @antifieldcomplexx/workbench",
    "test:web:coverage": "npm run test:web:coverage -w @antifieldcomplexx/workbench",
    "test:web:watch": "npm run test:web:watch -w @antifieldcomplexx/workbench",
    "check": "npm run check:app && npm run check:mcbot && npm run check:naming && npm run check:docs",
    "check:app": "npm run typecheck && npm run lint && npm run test && npm run test:web",
    "check:mcbot": "npm run check -w @antifieldcomplexx/mcbot",
    "check:naming": "node scripts/check-naming.mjs",
    "check:docs": "node scripts/check-mcbot-claims.mjs",
    "provision": "node scripts/provision.mjs",
    "backup": "node scripts/backup.mjs",
    "cleanup:legacy-memory": "node scripts/cleanup-legacy-memory.mjs"
  }
}
