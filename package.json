{
  "name": "antifieldcloud",
  "version": "0.7.2",
  "private": true,
  "license": "MIT",
  "description": "AntifieldCloud · Raspberry Pi 5 个人工作台",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/src/main.ts",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint server web scripts --max-warnings=0",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "test:web": "vitest run --config web/vitest.config.ts",
    "test:web:coverage": "vitest run --config web/vitest.config.ts --coverage",
    "test:web:watch": "vitest --config web/vitest.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:web",
    "provision": "node scripts/provision.mjs",
    "backup": "node scripts/backup.mjs",
    "cleanup:legacy-memory": "node scripts/cleanup-legacy-memory.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "http-proxy": "^1.18.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^26.6.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dompurify": "^3.4.17",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
