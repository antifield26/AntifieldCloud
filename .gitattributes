# 统一行尾，避免 Windows checkout 后 shell/TS 文件变成 CRLF。
* text=auto
*.sh text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.example text eol=lf
*.ps1 text eol=crlf
LICENSE text eol=lf
