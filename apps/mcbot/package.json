{
  "name": "@antifieldcomplexx/mcbot",
  "version": "1.0.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "mcbot（原 lofii-bot）Minecraft AI companion bot for Paper 26.1.2 on Raspberry Pi 5",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit test/agentic",
    "test:agentic": "node --test test/agentic",
    "acceptance:agentic": "node scripts/agentic-acceptance.mjs",
    "check": "npm run typecheck && npm test",
    "smoke": "node test/smoke/live.ts"
  },
  "dependencies": {
    "minecraft-data": "^3.119.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
