# mcbot（游戏内人格名 Lofii）环境模板：写入 /etc/mcbot/env，root:mcbot 0640
# Secrets are generated on the Pi by deploy/bootstrap-env.sh; never commit real values.

BOT_USERNAME=lofii
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=26.1
DATA_DIR=/var/lib/mcbot
MEMORY_DIR=/var/lib/mcbot/memory

HTTP_HOST=127.0.0.1
HTTP_PORT=3010
HTTP_TOKEN=replace-with-openssl-rand-hex-32
HTTP_CONTROL_TOKEN=replace-with-a-separate-openssl-rand-hex-32
HTTP_CONTROL_ENABLED=true
HTTP_ONLY_HIGH_RISK=false

SSE_MAX_CLIENTS=8
SSE_HEARTBEAT_MS=15000
SSE_BUFFER_EVENTS=500
CONTROL_RATE_LIMIT=30

TASK_PENDING_TTL_MS=600000
TASK_MAX_MINUTES=60
TASK_STATE_FILE=/var/lib/mcbot/task-state.json
QUEUE_MAX=3

RCON_ENABLED=true
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=replace-with-server-rcon-password
RCON_TIMEOUT_MS=4000
ADMIN_POLL_MS=60000

HISTORY_ENABLED=true
HISTORY_DB=/var/lib/mcbot/history.db
HISTORY_SAMPLE_MS=60000
HISTORY_RETENTION_DAYS=30

ALERTS_ENABLED=true
ALERT_COOLDOWN_MS=300000
ALERT_HEALTH_THRESHOLD=12

MINE_MIN_Y=60
MINE_MAX_Y=120
MINE_MAX_ORES=64
MINE_MAX_MINUTES=30
MINE_PROTECT_RADIUS=16
MINE_ORES=coal_ore,deepslate_coal_ore,iron_ore,deepslate_iron_ore,copper_ore,deepslate_copper_ore

FOREST_SPECIES=oak,spruce,birch
FOREST_PROTECT_RADIUS=16
FOREST_MAX_LOGS=128
FOREST_DEPOSIT_EVERY_MS=300000

BED_SEARCH_RADIUS=16
SLEEP_VOTE_WAIT_MS=45000
PATROL_MAX_MINUTES=15

TREE_FARM_MIN_X=180
TREE_FARM_MAX_X=193
TREE_FARM_MIN_Z=455
TREE_FARM_MAX_Z=464
TREE_FARM_GROUND_Y=63
TREE_FARM_LOG_MIN_Y=64
TREE_FARM_MAX_Y=96
TREE_LOG_TYPE=oak_log
TREE_SAPLING_TYPE=oak_sapling
TREE_MAX_LOGS=128
TREE_DEPOSIT_EVERY_MS=300000

DEFENSE_ENABLED=true
DEFENSE_RADIUS=12
DEFENSE_HEALTH_THRESHOLD=12
DEFENSE_FOOD_THRESHOLD=6
DEFENSE_MAX_HOSTILES=2
DEFENSE_TARGETS=zombie,husk,drowned,skeleton,stray,spider,cave_spider
CHUNK_WAIT_MS=5000

MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_TURNS=40
MEMORY_SUMMARY_MAX_CHARS=1000

AUDIT_FILE=/var/lib/mcbot/audit.jsonl
AUDIT_MAX_BYTES=5242880
AUDIT_RETENTION_DAYS=30

COMMAND_ALLOWLIST=Antifield

PRESENCE_ENABLED=true
FORCE_ONLINE=false
# auto=有玩家/任务时在线；always=常驻；off=不主动上线。presence.json 优先于本默认值。
PRESENCE_MODE=auto
PRESENCE_FILE=/var/lib/mcbot/presence.json
PRESENCE_POLL_MS=15000
PRESENCE_GRACE_MS=60000
PRESENCE_QUIT_COOLDOWN_MS=10000
PRESENCE_CHECK_MS=5000

RECONNECT_MIN_MS=5000
RECONNECT_MAX_MS=60000
LOGIN_TIMEOUT_MS=45000

AI_ENABLED=true
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=replace-with-opencode-password
AI_MODEL_PROVIDER=opencode-go
AI_MODEL_ID=deepseek-v4.1-flash
AI_TIMEOUT_MS=45000
AI_MAX_PROMPT_CHARS=6000
AI_MAX_LINES=3
AI_MAX_LINE_CHARS=240
AI_COOLDOWN_MS=10000
AI_QUEUE_MAX=4
AI_RATE_PER_HOUR=60

CHAT_MAX_INPUT_CHARS=500
MEMORY_MAX_TURNS=20
MEMORY_RETENTION_DAYS=30

# v0.2 automation / base layout (defaults are the current Pi base)
TASK_ENABLED=true
BOT_HOME_X=175.5
BOT_HOME_Y=64
BOT_HOME_Z=410.5
SAFE_MIN_X=111
SAFE_MAX_X=239
SAFE_MIN_Z=410
SAFE_MAX_Z=474
FARM_MIN_X=177
FARM_MAX_X=183
FARM_MIN_Z=432
FARM_MAX_Z=439
FARM_GROUND_Y=63
FARM_CROP_Y=64
CHEST_X=184
CHEST_Y=64
CHEST_Z=435
FISH_STAND_X=204.5
FISH_STAND_Y=63
FISH_STAND_Z=469.5
FISH_WATER_X=204.5
FISH_WATER_Y=62.5
FISH_WATER_Z=470.5
TASK_RECOVERY_MAX=3
TELEPORT_DISTANCE=64
TASK_ANCHOR_TELEPORT=true
AUTO_DEPOSIT=true

PROACTIVE_ENABLED=true
PROACTIVE_GREETING=true
PROACTIVE_EVENTS=true

AI_INTENT_ENABLED=true
AI_INTENT_TIMEOUT_MS=5000
AI_INTENT_MIN_CONFIDENCE=0.7

LOG_LEVEL=info
LOG_AI_PROMPT=false

# v1.0.0 运行时稳定性（systemd Type=notify 看门狗；RSS 0=关闭告警）
WATCHDOG_ENABLED=true
WATCHDOG_HEARTBEAT_MS=20000
RSS_LIMIT_MB=0
RSS_CHECK_MS=30000

# v1.0.0 AI 受控工具（默认关闭；只读工具可安全开启）
AI_TOOLS_ENABLED=false
AI_TOOL_ALLOWLIST=status,inventory,task_status
AI_MAX_TOOL_CALLS=2

# v1.0.2 AI 自主会话（默认关闭；仅主人显式启动；OpenCode 原生 MCP 工具）
AUTONOMY_ENABLED=false
AUTONOMY_MAX_MINUTES=20
AUTONOMY_MAX_TOOL_CALLS=12
AUTONOMY_MAX_FAILURES=2
AUTONOMY_GOAL_MAX_CHARS=200
AUTONOMY_DECISION_TIMEOUT_MS=180000
AUTONOMY_MCP_WARMUP_MS=3000
AUTONOMY_SCAN_RADIUS=16
AUTONOMY_SCAN_MAX_BLOCKS=48
AUTONOMY_SCAN_BLOCKS=chest,trapped_chest,barrel,ender_chest,*_bed,water,crafting_table,furnace,blast_furnace,smoker,wheat,carrots,potatoes,beetroots,*_log,*_ore
AUTONOMY_CHEST_READ_ENABLED=true
AUTONOMY_CHEST_PATH_TIMEOUT_MS=12000
AUTONOMY_EAT_BELOW=18
AUTONOMY_ACTION_COOLDOWN_MS=5000
AUTONOMY_EVENT_DEBOUNCE_MS=30000
AUTONOMY_MAX_REPROMPTS=6
AUTONOMY_TASKS=fishing,farming,woodcutting,mining,forest,sleep,patrol,guard,escort,explore,clearing

# v1.0.5 自动生存/补货：默认全部开启；只在空闲且无任务/自主会话时执行
INVENTORY_ALERT_FREE_SLOTS=2
FOOD_ALERT_THRESHOLD=4
AUTO_RESTOCK=true
AUTO_RESTOCK_INTERVAL_MS=300000
AUTO_SURVIVAL=true
AUTO_SURVIVAL_INTERVAL_MS=5000
AUTO_EAT_BELOW=16

# v1.0.5 多步目标：本地 SQLite，重启后保留为 paused，不自动执行
GOALS_FILE=/var/lib/mcbot/goals.db
GOALS_MAX_STEPS=5

# v1.0.0 深层裸露矿（默认关闭；仅安全区内、有空气面、无液体邻接）
MINE_DEEP_ENABLED=false
MINE_DEEP_MIN_Y=0
MINE_DEEP_MAX_Y=59

# v1.0.0 分类存箱（可选；缺失分类回退 CHEST_X/Y/Z 主箱）
# CHEST_ORES_X=184
# CHEST_ORES_Y=64
# CHEST_ORES_Z=437
# CHEST_FOOD_X=186
# CHEST_FOOD_Y=64
# CHEST_FOOD_Z=437
# CHEST_SAPLINGS_X=188
# CHEST_SAPLINGS_Y=64
# CHEST_SAPLINGS_Z=437
# CHEST_MISC_X=190
# CHEST_MISC_Y=64
# CHEST_MISC_Z=437

# v1.0.0 守卫/护送/航点探索
GUARD_RADIUS=16
ESCORT_DISTANCE=12
# EXPLORE_WAYPOINTS=home:175:64:410;farm:180:64:435
