# mcbot（游戏内人格名 Lofii）环境模板：写入 /etc/mcbot/env，root:mcbot 0640
# Secrets are generated on the Pi by deploy/bootstrap-env.sh; never commit real values.

BOT_USERNAME=lofii
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=26.1
DATA_DIR=/var/lib/mcbot
MEMORY_DIR=/var/lib/mcbot/memory

HTTP_HOST=127.0.0.1
HTTP_PORT=3010
HTTP_TOKEN=replace-with-openssl-rand-hex-32
HTTP_CONTROL_TOKEN=replace-with-a-separate-openssl-rand-hex-32
HTTP_CONTROL_ENABLED=true
HTTP_ONLY_HIGH_RISK=false

SSE_MAX_CLIENTS=8
SSE_HEARTBEAT_MS=15000
SSE_BUFFER_EVENTS=500
CONTROL_RATE_LIMIT=30

TASK_PENDING_TTL_MS=600000
TASK_MAX_MINUTES=60
TASK_STATE_FILE=/var/lib/mcbot/task-state.json
QUEUE_MAX=3

RCON_ENABLED=true
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=replace-with-server-rcon-password
RCON_TIMEOUT_MS=4000
ADMIN_POLL_MS=60000

HISTORY_ENABLED=true
HISTORY_DB=/var/lib/mcbot/history.db
HISTORY_SAMPLE_MS=60000
HISTORY_RETENTION_DAYS=30

ALERTS_ENABLED=true
ALERT_COOLDOWN_MS=300000
ALERT_HEALTH_THRESHOLD=12

MINE_MIN_Y=60
MINE_MAX_Y=120
MINE_MAX_ORES=64
MINE_MAX_MINUTES=30
MINE_PROTECT_RADIUS=16
MINE_ORES=coal_ore,deepslate_coal_ore,iron_ore,deepslate_iron_ore,copper_ore,deepslate_copper_ore

FOREST_SPECIES=oak,spruce,birch
FOREST_PROTECT_RADIUS=16
FOREST_MAX_LOGS=128
FOREST_DEPOSIT_EVERY_MS=300000

BED_SEARCH_RADIUS=16
SLEEP_VOTE_WAIT_MS=45000
PATROL_MAX_MINUTES=15

TREE_FARM_MIN_X=180
TREE_FARM_MAX_X=193
TREE_FARM_MIN_Z=455
TREE_FARM_MAX_Z=464
TREE_FARM_GROUND_Y=63
TREE_FARM_LOG_MIN_Y=64
TREE_FARM_MAX_Y=96
TREE_LOG_TYPE=oak_log
TREE_SAPLING_TYPE=oak_sapling
TREE_MAX_LOGS=128
TREE_DEPOSIT_EVERY_MS=300000

DEFENSE_ENABLED=true
DEFENSE_RADIUS=12
DEFENSE_HEALTH_THRESHOLD=12
DEFENSE_FOOD_THRESHOLD=6
DEFENSE_MAX_HOSTILES=2
DEFENSE_TARGETS=zombie,husk,drowned,skeleton,stray,spider,cave_spider
CHUNK_WAIT_MS=5000

MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_TURNS=40
MEMORY_SUMMARY_MAX_CHARS=1000

AUDIT_FILE=/var/lib/mcbot/audit.jsonl
AUDIT_MAX_BYTES=5242880
AUDIT_RETENTION_DAYS=30

COMMAND_ALLOWLIST=Antifield

PRESENCE_ENABLED=true
FORCE_ONLINE=false
PRESENCE_POLL_MS=15000
PRESENCE_GRACE_MS=60000
PRESENCE_QUIT_COOLDOWN_MS=10000
PRESENCE_CHECK_MS=5000

RECONNECT_MIN_MS=5000
RECONNECT_MAX_MS=60000
LOGIN_TIMEOUT_MS=45000

AI_ENABLED=true
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=replace-with-opencode-password
AI_MODEL_PROVIDER=opencode-go
AI_MODEL_ID=deepseek-v4.1-flash
AI_TIMEOUT_MS=45000
AI_MAX_PROMPT_CHARS=6000
AI_MAX_LINES=3
AI_MAX_LINE_CHARS=240
AI_COOLDOWN_MS=10000
AI_QUEUE_MAX=4
AI_RATE_PER_HOUR=60

CHAT_MAX_INPUT_CHARS=500
MEMORY_MAX_TURNS=20
MEMORY_RETENTION_DAYS=30

# v0.2 automation / base layout (defaults are the current Pi base)
TASK_ENABLED=true
BOT_HOME_X=175.5
BOT_HOME_Y=64
BOT_HOME_Z=410.5
SAFE_MIN_X=111
SAFE_MAX_X=239
SAFE_MIN_Z=410
SAFE_MAX_Z=474
FARM_MIN_X=177
FARM_MAX_X=183
FARM_MIN_Z=432
FARM_MAX_Z=439
FARM_GROUND_Y=63
FARM_CROP_Y=64
CHEST_X=184
CHEST_Y=64
CHEST_Z=435
FISH_STAND_X=204.5
FISH_STAND_Y=63
FISH_STAND_Z=469.5
FISH_WATER_X=204.5
FISH_WATER_Y=62.5
FISH_WATER_Z=470.5
TASK_RECOVERY_MAX=3
TELEPORT_DISTANCE=64
TASK_ANCHOR_TELEPORT=true
AUTO_DEPOSIT=true

PROACTIVE_ENABLED=true
PROACTIVE_GREETING=true
PROACTIVE_EVENTS=true

AI_INTENT_ENABLED=true
AI_INTENT_TIMEOUT_MS=5000
AI_INTENT_MIN_CONFIDENCE=0.7

LOG_LEVEL=info
LOG_AI_PROMPT=false
